#!/usr/bin/env bash
# cosign de teste (só entra no PATH nos testes que o querem): registra e falha se pedido por SHIM_FALHAR.
linha="$*"
printf 'cosign %s\n' "$linha" >>"${SHIM_LOG:?}"
[[ "$1" == version ]] && { echo "GitVersion:    ${SHIM_COSIGN_VERSAO:-v3.1.3}"; exit 0; }
# shellcheck disable=SC2053  # o padrão é glob de propósito (o teste escolhe que chamada falha)
[[ -n "${SHIM_FALHAR_COSIGN:-}" && "$linha" == $SHIM_FALHAR_COSIGN ]] && exit 1
exit 0
