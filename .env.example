# Configuração do Sentinela. O ./install.sh copia este arquivo para .env (chmod 600)
# e preenche as chaves (sessão e credenciais); nunca versione o .env.

# Segredo de sessão: gerado pelo install.sh com `openssl rand -hex 32`. Deixe vazio aqui.
SENTINELA_CHAVE_SESSAO=

# Chave que cifra as credenciais das fontes de descoberta (32 bytes em hex): gerada pelo
# install.sh. Deixe vazio aqui. Perdê-la torna as credenciais salvas ilegíveis: guarde o .env.
# Num .env de versão anterior (sem esta linha), rodar ./install.sh de novo só acrescenta esta
# chave; as demais ficam como estão. Fontes de descoberta: cadastre pela tela (Configurações).
SENTINELA_CHAVE_CREDENCIAIS=

# producao (padrão) desliga /docs e exige Origin https no WebSocket.
SENTINELA_AMBIENTE=producao

# Teto global de sondas por segundo (1-100).
SENTINELA_TETO_PPS=20

# Portas publicadas no host (LAN).
SENTINELA_PORTA_HTTPS=443
SENTINELA_PORTA_HTTP=80

# Fuso dos textos (Telegram, telão, painel) e do atalho "até amanhã 08:00". O banco fica em UTC.
# Nome IANA (ex.: America/Sao_Paulo). Valor inválido impede a subida do núcleo.
SENTINELA_FUSO=America/Sao_Paulo

# Rede e gateway sugeridos no primeiro acesso: preenchidas pelo instalar.sh; só sugestão do
# primeiro acesso; nada vai para a rede. Valor inválido é ignorado (os campos ficam em branco).
SENTINELA_REDE_SUGERIDA=
SENTINELA_GATEWAY_SUGERIDO=

# CA adicional (arquivo PEM) para o HTTPS do Telegram: só para testes; quem muda já controla o .env.
# É um caminho dentro do contêiner: exige montar o arquivo (só testes). Deixe vazio em produção
# (vale a lista de CAs públicas). Caminho inexistente impede a subida.
SENTINELA_CA_ADICIONAL=

# O token do bot do Telegram e os chats NÃO ficam aqui: configure em Configurações → Telegram
# (o token é cifrado no banco com SENTINELA_CHAVE_CREDENCIAIS). Sem token, nenhum pacote sai para
# a internet. A chave "permitir telão sem HTTPS" também é ligada pela tela, não pelo .env.

# Origem das imagens do Sentinela, usada pelo ./update.sh.
#   publicadas  baixa do ghcr.io as imagens assinadas da versão em VERSAO (só vale com VERSAO preenchida)
#   locais      constrói as imagens neste computador a partir do código (./install.sh --build)
# O ./install.sh preenche as duas linhas na instalação nova (VERSAO vem de core/pyproject.toml, X.Y.Z sem
# o "v"); o ./update.sh --imagens-publicadas também as grava. Deixe como está aqui. Num .env antigo (sem
# estas linhas) o install.sh acrescenta IMAGENS=locais e o update.sh reconstrói.
IMAGENS=publicadas
VERSAO=

# O core roda com um só worker do uvicorn (o login em duas etapas e os limites de tentativas ficam em
# memória). WEB_CONCURRENCY maior que 1 faz o core recusar subir: não defina.
