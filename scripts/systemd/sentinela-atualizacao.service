# Unidade da atualização automática. O instalar.sh troca os marcadores ao instalar:
#   @DESTINO@  pasta da instalação (onde está o update.sh)
#   @USUARIO@  dono dessa pasta, que está no grupo docker; NUNCA root (root quebraria o git
#              "dubious ownership" e deixaria arquivos da árvore com dono root)
[Unit]
Description=Sentinela: atualização automática (update.sh --automatico)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=@USUARIO@
WorkingDirectory=@DESTINO@
ExecStart=@DESTINO@/update.sh --automatico
TimeoutStartSec=45min
Nice=10
